---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { config } from '../config';
import { showDrafts, absoluteUrl } from '../lib/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object[];
  ogType?: 'website' | 'article';
  hasMobileBar?: boolean;
}

const { title, description, noindex = false, jsonLd = [], ogType = 'website', hasMobileBar = false } = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl('/og-default.png');
const fullTitle = title.includes(config.siteName) ? title : `${title} | ${config.siteName}`;
const blockIndexing = noindex || showDrafts;
const beacon = config.analytics.cloudflareBeaconToken;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content={config.siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class:list={['min-h-screen flex flex-col', hasMobileBar && 'pb-24 lg:pb-0']}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:shadow-lg"
    >
      Skip to content
    </a>
    {
      showDrafts && (
        <div class="bg-amber-100 px-4 py-2 text-center text-sm font-medium text-amber-900">
          PREVIEW BUILD: draft guides are visible here. This is hidden from search engines and is not your live site.
        </div>
      )
    }
    <Header />
    <slot />
    <Footer />
    {beacon && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
  </body>
</html>
