---
import Handshake from '@lucide/astro/icons/handshake';
import type { Partner } from '../data/types';

interface Props {
  partner?: Partner;
  platformName: string;
}
const { partner, platformName } = Astro.props;
---

<section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="partner-heading">
  <div class="flex items-center gap-2 text-sm font-semibold text-slate-600">
    <Handshake size={16} aria-hidden="true" />
    {partner ? 'Recommended Setup Partner' : 'Verified Installer'}
    {partner && <span class="ml-auto rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-500">Sponsored</span>}
  </div>
  {
    partner ? (
      <>
        <h2 id="partner-heading" class="mt-1 text-base font-bold text-slate-900">{partner.name}</h2>
        <p class="mt-1 text-sm text-slate-600">{partner.blurb}</p>
        <a
          href={partner.url}
          rel="sponsored nofollow noopener"
          target="_blank"
          class="mt-3 inline-block rounded-md border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-50"
        >
          Visit {partner.name}
        </a>
      </>
    ) : (
      <>
        <h2 id="partner-heading" class="mt-1 text-base font-bold text-slate-900">Are you a {platformName} expert?</h2>
        <p class="mt-1 text-sm text-slate-600">
          Agencies and freelancers can apply to be the recommended setup partner on guides like this one.
        </p>
        <a
          href="/partners/"
          class="mt-3 inline-block rounded-md border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-50"
        >
          Become our partner
        </a>
      </>
    )
  }
</section>
