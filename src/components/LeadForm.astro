---
// One reusable form. Sends to Web3Forms (free) with a small script, no backend needed.
import { config, isConfigured } from '../config';

export interface Field {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'url' | 'textarea' | 'hidden' | 'select';
  required?: boolean;
  placeholder?: string;
  options?: string[];
  value?: string;
  help?: string;
}

interface Props {
  formType: string; // shows up in the email you receive, e.g. "Guide request"
  fields: Field[];
  button: string;
  successMessage: string;
  id?: string;
}
const { formType, fields, button, successMessage, id } = Astro.props;
const keyReady = !config.forms.web3formsAccessKey.includes('TODO');
---

<form
  data-lead-form
  method="POST"
  action={config.forms.endpoint}
  class="space-y-4"
  id={id}
  data-success={successMessage}
>
  <input type="hidden" name="access_key" value={config.forms.web3formsAccessKey} />
  <input type="hidden" name="subject" value={`${config.siteName}: ${formType}`} />
  <input type="hidden" name="from_name" value={config.siteName} />
  <input type="hidden" name="form_type" value={formType} />
  <input type="hidden" name="page_url" value="" data-page-url />
  <!-- Spam trap: real people never see or tick this -->
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" style="display:none" />

  {
    fields.map((f) =>
      f.type === 'hidden' ? (
        <input type="hidden" name={f.name} value={f.value ?? ''} />
      ) : (
        <div>
          <label for={`${id ?? formType}-${f.name}`} class="block text-sm font-medium text-slate-800">
            {f.label}
            {f.required && <span class="text-red-600" aria-hidden="true"> *</span>}
          </label>
          {f.type === 'textarea' ? (
            <textarea
              id={`${id ?? formType}-${f.name}`}
              name={f.name}
              rows="4"
              required={f.required}
              placeholder={f.placeholder}
              class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm"
            >{f.value}</textarea>
          ) : f.type === 'select' ? (
            <select
              id={`${id ?? formType}-${f.name}`}
              name={f.name}
              required={f.required}
              class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm"
            >
              {(f.options ?? []).map((o) => <option value={o}>{o}</option>)}
            </select>
          ) : (
            <input
              id={`${id ?? formType}-${f.name}`}
              type={f.type ?? 'text'}
              name={f.name}
              required={f.required}
              placeholder={f.placeholder}
              value={f.value}
              autocomplete={f.type === 'email' ? 'email' : 'off'}
              class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm"
            />
          )}
          {f.help && <p class="mt-1 text-xs text-slate-500">{f.help}</p>}
        </div>
      ),
    )
  }

  <button
    type="submit"
    class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 disabled:opacity-60"
  >
    {button}
  </button>
  <p class="form-status text-sm" role="status" aria-live="polite"></p>
  {
    !keyReady && (
      <p class="rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-800">
        Setup note: add your Web3Forms access key in src/config.ts to make this form work.
      </p>
    )
  }
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
    const pageField = form.querySelector<HTMLInputElement>('[data-page-url]');
    if (pageField) pageField.value = window.location.href;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('.form-status');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const key = (form.querySelector('[name="access_key"]') as HTMLInputElement).value;
      if (!key || key.includes('TODO')) {
        if (status) {
          status.textContent = 'This form is not connected yet. The site owner needs to add a Web3Forms access key.';
          status.className = 'form-status text-sm text-red-700';
        }
        return;
      }
      if (button) button.disabled = true;
      if (status) {
        status.textContent = 'Sending...';
        status.className = 'form-status text-sm text-slate-600';
      }
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.message || 'Failed');
        form.reset();
        if (status) {
          status.textContent = form.dataset.success ?? 'Thank you! We got your message.';
          status.className = 'form-status text-sm font-medium text-emerald-700';
        }
      } catch {
        if (status) {
          status.textContent = 'Sorry, something went wrong. Please try again in a moment.';
          status.className = 'form-status text-sm text-red-700';
        }
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>
