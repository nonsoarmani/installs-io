---
import Clock from '@lucide/astro/icons/clock';
import { guideUrl, toolById, platformById } from '../lib/site';
import type { Guide } from '../data/types';

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const tool = toolById(guide.toolId);
const platform = platformById(guide.platformId);
---

<a
  href={guideUrl(guide.slug)}
  class="group flex flex-col rounded-xl border border-slate-200 bg-white p-4 transition hover:border-indigo-300 hover:shadow-md"
>
  <div class="flex items-center gap-2">
    <img src={tool.logo} alt="" width="28" height="28" class="h-7 w-7 rounded-md" />
    <span class="text-slate-400" aria-hidden="true">+</span>
    <img src={platform.logo} alt="" width="28" height="28" class="h-7 w-7 rounded-md" />
    {guide.status === 'draft' && <span class="ml-auto rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-800">Draft</span>}
  </div>
  <p class="mt-3 font-semibold text-slate-900 group-hover:text-indigo-700">{tool.name} on {platform.name}</p>
  <p class="mt-1 line-clamp-2 text-sm text-slate-600">{guide.whatYouGet}</p>
  <p class="mt-3 flex items-center gap-1 text-xs text-slate-500">
    <Clock size={12} aria-hidden="true" /> {guide.estimatedMinutes} min &middot; {guide.difficulty}
  </p>
</a>
