---
import ChevronRight from '@lucide/astro/icons/chevron-right';

interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-slate-600">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1">
          {item.href ? <a href={item.href} class="hover:text-slate-900 hover:underline">{item.name}</a> : <span aria-current="page" class="text-slate-900">{item.name}</span>}
          {i < items.length - 1 && <ChevronRight size={14} aria-hidden="true" />}
        </li>
      ))
    }
  </ol>
</nav>
