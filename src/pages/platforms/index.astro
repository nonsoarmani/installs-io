---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { activePlatforms, guidesForPlatform, platformUrl } from '../../lib/site';
---

<Base title="Install Guides by Platform" description="Browse step-by-step install guides for Shopify, Webflow, WordPress and more. Pick your platform to see every tool you can add.">
  <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Platforms' }]} />
    <h1 class="mt-6 text-3xl font-extrabold text-slate-900">Install guides by platform</h1>
    <p class="mt-2 max-w-2xl text-slate-600">Choose the platform your site runs on to see every tool we have a guide for.</p>
    {
      activePlatforms.length === 0 ? (
        <p class="mt-6 text-slate-600">Guides are on the way. <a href="/request-a-guide/" class="underline">Request one</a>.</p>
      ) : (
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {activePlatforms.map((p) => (
            <a href={platformUrl(p.slug)} class="rounded-xl border border-slate-200 bg-white p-5 transition hover:border-indigo-300 hover:shadow-md">
              <div class="flex items-center gap-3">
                <img src={p.logo} alt="" width="40" height="40" class="h-10 w-10 rounded-lg" />
                <span class="text-lg font-semibold text-slate-900">{p.name}</span>
              </div>
              <p class="mt-3 text-sm text-slate-600">{p.shortDescription}</p>
              <p class="mt-3 text-sm font-medium text-indigo-700">{guidesForPlatform(p.id).length} guide{guidesForPlatform(p.id).length === 1 ? '' : 's'}</p>
            </a>
          ))}
        </div>
      )
    }
  </main>
</Base>
