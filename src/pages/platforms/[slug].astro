---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import { activePlatforms, guidesForPlatform, platformUrl, absoluteUrl } from '../../lib/site';
import type { Platform } from '../../data/types';

export function getStaticPaths() {
  return activePlatforms.map((platform) => ({ params: { slug: platform.slug }, props: { platform } }));
}

const { platform } = Astro.props as { platform: Platform };
const list = guidesForPlatform(platform.id);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Platforms', href: '/platforms/' }, { name: platform.name }];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.href ? absoluteUrl(c.href) : absoluteUrl(platformUrl(platform.slug)),
  })),
};
---

<Base
  title={`Install Guides for ${platform.name}`}
  description={`Step-by-step guides for adding tools to ${platform.name}: ${list.length} install guide${list.length === 1 ? '' : 's'}, each with testing and troubleshooting help.`}
  jsonLd={[breadcrumbLd]}
>
  <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
    <Breadcrumbs items={crumbs} />
    <div class="mt-6 flex items-center gap-3">
      <img src={platform.logo} alt="" width="48" height="48" class="h-12 w-12 rounded-lg" />
      <h1 class="text-3xl font-extrabold text-slate-900">Install guides for {platform.name}</h1>
    </div>
    <p class="mt-3 max-w-3xl text-slate-600">{platform.longDescription}</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {list.map((g) => <GuideCard guide={g} />)}
    </div>
    <p class="mt-10 text-slate-600">Missing a tool? <a href="/request-a-guide/" class="font-medium text-indigo-700 underline">Request a guide</a>.</p>
  </main>
</Base>
