---
import Base from '../layouts/Base.astro';
import Configurator from '../components/Configurator.astro';
---

<Base title="Page Not Found" description="That page does not exist. Find an install guide with the tool finder." noindex>
  <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-4 py-16 text-center">
    <p class="text-sm font-semibold text-indigo-700">404</p>
    <h1 class="mt-2 text-3xl font-extrabold text-slate-900">We could not find that page</h1>
    <p class="mt-3 text-slate-600">It may have moved. Try finding the guide you need here, or go back to the <a href="/" class="underline">homepage</a>.</p>
    <div class="mt-8 text-left"><Configurator /></div>
  </main>
</Base>
