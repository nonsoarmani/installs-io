---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { activeTools, guidesForTool, toolUrl } from '../../lib/site';
---

<Base title="Install Guides by Tool" description="Browse install guides by tool: Klaviyo, Google Analytics 4, Meta Conversions API, Crisp, PostHog and more, for every platform we cover.">
  <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Tools' }]} />
    <h1 class="mt-6 text-3xl font-extrabold text-slate-900">Install guides by tool</h1>
    <p class="mt-2 max-w-2xl text-slate-600">Choose a tool to see how to install it on each platform.</p>
    {
      activeTools.length === 0 ? (
        <p class="mt-6 text-slate-600">Guides are on the way. <a href="/request-a-guide/" class="underline">Request one</a>.</p>
      ) : (
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {activeTools.map((t) => (
            <a href={toolUrl(t.slug)} class="rounded-xl border border-slate-200 bg-white p-5 transition hover:border-indigo-300 hover:shadow-md">
              <div class="flex items-center gap-3">
                <img src={t.logo} alt="" width="40" height="40" class="h-10 w-10 rounded-lg" />
                <span class="text-lg font-semibold text-slate-900">{t.name}</span>
              </div>
              <p class="mt-3 text-sm text-slate-600">{t.shortDescription}</p>
              <p class="mt-3 text-sm font-medium text-indigo-700">{guidesForTool(t.id).length} guide{guidesForTool(t.id).length === 1 ? '' : 's'}</p>
            </a>
          ))}
        </div>
      )
    }
  </main>
</Base>
