---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import { activeTools, guidesForTool, toolUrl, absoluteUrl } from '../../lib/site';
import type { Tool } from '../../data/types';

export function getStaticPaths() {
  return activeTools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props as { tool: Tool };
const list = guidesForTool(tool.id);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Tools', href: '/tools/' }, { name: tool.name }];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.href ? absoluteUrl(c.href) : absoluteUrl(toolUrl(tool.slug)),
  })),
};
---

<Base
  title={`How to Install ${tool.name}: Guides by Platform`}
  description={`Step-by-step ${tool.name} install guides. ${tool.shortDescription} Pick your platform to get started.`}
  jsonLd={[breadcrumbLd]}
>
  <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
    <Breadcrumbs items={crumbs} />
    <div class="mt-6 flex items-center gap-3">
      <img src={tool.logo} alt="" width="48" height="48" class="h-12 w-12 rounded-lg" />
      <h1 class="text-3xl font-extrabold text-slate-900">How to install {tool.name}</h1>
    </div>
    <p class="mt-3 max-w-3xl text-slate-600">{tool.longDescription}</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {list.map((g) => <GuideCard guide={g} />)}
    </div>
    <div class="mt-10 rounded-lg border border-slate-200 bg-slate-50 p-4">
      <p class="text-sm font-medium text-slate-800">{tool.affiliateCtaText}</p>
      <a
        href={tool.affiliateUrl}
        target="_blank"
        rel={tool.affiliateDisclosure ? 'sponsored nofollow noopener' : 'noopener'}
        class="mt-2 inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
      >
        Go to {tool.name}
      </a>
      {tool.affiliateDisclosure && <p class="mt-2 text-xs text-slate-600">{`We may earn a commission if you sign up through this link, at no extra cost to you.`}</p>}
    </div>
  </main>
</Base>
