---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ExpressCard from '../../components/ExpressCard.astro';
import PartnerCard from '../../components/PartnerCard.astro';
import MobileBar from '../../components/MobileBar.astro';
import LeadForm from '../../components/LeadForm.astro';
import GuideCard from '../../components/GuideCard.astro';
import Clock from '@lucide/astro/icons/clock';
import Gauge from '@lucide/astro/icons/gauge';
import BadgeCheck from '@lucide/astro/icons/badge-check';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Info from '@lucide/astro/icons/info';
import { config } from '../../config';
import {
  visibleGuides,
  guideUrl,
  platformUrl,
  toolById,
  platformById,
  partnerFor,
  formatDate,
  isoDuration,
  absoluteUrl,
} from '../../lib/site';
import type { Guide } from '../../data/types';

export function getStaticPaths() {
  return visibleGuides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const tool = toolById(guide.toolId);
const platform = platformById(guide.platformId);
const partner = partnerFor(guide);
const related = guide.relatedSlugs
  .map((s) => visibleGuides.find((g) => g.slug === s))
  .filter((g): g is Guide => Boolean(g));

const pageUrl = absoluteUrl(guideUrl(guide.slug));
const isDraft = guide.status === 'draft';

// ---------- Structured data (JSON-LD) ----------
const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: guide.title,
  description: guide.metaDescription,
  totalTime: isoDuration(guide.estimatedMinutes),
  step: guide.steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.body,
    url: `${pageUrl}#step-${i + 1}`,
  })),
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
const crumbs = [
  { name: 'Home', href: '/' },
  { name: platform.name, href: platformUrl(platform.slug) },
  { name: `${tool.name} on ${platform.name}` },
];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: c.href ? absoluteUrl(c.href) : pageUrl,
  })),
};
---

<Base
  title={guide.title}
  description={guide.metaDescription}
  ogType="article"
  noindex={isDraft}
  jsonLd={[howTo, faqLd, breadcrumbLd]}
  hasMobileBar
>
  <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
    <Breadcrumbs items={crumbs} />

    <article class="mt-6 lg:grid lg:grid-cols-[minmax(0,7fr)_minmax(0,3fr)] lg:gap-10" data-guide={guide.slug}>
      <div>
        {
          isDraft && (
            <div class="mb-6 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
              <strong>Draft guide.</strong> This guide has not been verified against the vendor's current documentation and is
              hidden from the live site. Items marked "TODO: verify" must be checked before publishing.
            </div>
          )
        }

        <header>
          <div class="flex items-center gap-2">
            <img src={tool.logo} alt={`${tool.name} logo`} width="44" height="44" class="h-11 w-11 rounded-lg" />
            <span class="text-slate-400" aria-hidden="true">+</span>
            <img src={platform.logo} alt={`${platform.name} logo`} width="44" height="44" class="h-11 w-11 rounded-lg" />
          </div>
          <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{guide.title}</h1>
          <ul class="mt-4 flex flex-wrap gap-2 text-sm">
            <li class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-slate-700">
              <Gauge size={14} aria-hidden="true" /> Difficulty: {guide.difficulty}
            </li>
            <li class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-slate-700">
              <Clock size={14} aria-hidden="true" /> About {guide.estimatedMinutes} minutes
            </li>
            {
              guide.lastVerified ? (
                <li class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-emerald-800">
                  <BadgeCheck size={14} aria-hidden="true" /> Last verified: <time datetime={guide.lastVerified}>{formatDate(guide.lastVerified)}</time>
                </li>
              ) : (
                <li class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-amber-900">Not yet verified</li>
              )
            }
          </ul>

          <!-- Affiliate box -->
          <div class="mt-5 rounded-lg border border-slate-200 bg-slate-50 p-4">
            <p class="text-sm font-medium text-slate-800">{tool.affiliateCtaText}</p>
            <a
              href={tool.affiliateUrl}
              target="_blank"
              rel={tool.affiliateDisclosure ? 'sponsored nofollow noopener' : 'noopener'}
              class="mt-2 inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
            >
              Go to {tool.name}
            </a>
            {
              tool.affiliateDisclosure && (
                <p class="mt-2 flex items-start gap-1.5 text-xs text-slate-600">
                  <Info size={13} class="mt-0.5 shrink-0" aria-hidden="true" />
                  {config.legal.affiliateDisclosure}
                </p>
              )
            }
          </div>
        </header>

        <section class="mt-8" aria-labelledby="overview">
          <h2 id="overview" class="text-xl font-bold text-slate-900">Who this is for</h2>
          <p class="mt-2 leading-relaxed text-slate-700">{guide.whoItsFor}</p>
          <h2 class="mt-6 text-xl font-bold text-slate-900">What you'll get</h2>
          <p class="mt-2 leading-relaxed text-slate-700">{guide.whatYouGet}</p>
        </section>

        <section class="mt-8" aria-labelledby="prereq">
          <h2 id="prereq" class="text-xl font-bold text-slate-900">Before you start</h2>
          <p class="mt-1 text-sm text-slate-500">Tick each item as you check it. Your ticks are remembered on this device.</p>
          <ul class="mt-3 space-y-2" id="prereq-list">
            {
              guide.prerequisites.map((p, i) => (
                <li>
                  <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-3 hover:bg-slate-50">
                    <input type="checkbox" data-prereq={i} class="mt-1 h-4 w-4 shrink-0 accent-indigo-600" />
                    <span class="text-slate-800">{p}</span>
                  </label>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="mt-10" aria-labelledby="steps-heading">
          <h2 id="steps-heading" class="text-2xl font-bold text-slate-900">Step-by-step instructions</h2>
          <ol class="mt-5 space-y-8">
            {
              guide.steps.map((s, i) => (
                <li id={`step-${i + 1}`} class="flex gap-4">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white" aria-hidden="true">
                    {i + 1}
                  </span>
                  <div class="min-w-0 flex-1">
                    <h3 class="text-lg font-semibold text-slate-900">{s.title}</h3>
                    <p class="mt-1 leading-relaxed text-slate-700">{s.body}</p>
                    {s.image && <img src={s.image} alt={s.imageAlt} loading="lazy" class="mt-3 rounded-lg border border-slate-200" />}
                    {s.code && <CodeBlock block={s.code} />}
                    {s.note && <p class="mt-3 rounded-md bg-sky-50 px-3 py-2 text-sm text-sky-900"><strong>Note:</strong> {s.note}</p>}
                    {s.warning && <p class="mt-3 rounded-md bg-red-50 px-3 py-2 text-sm text-red-900"><strong>Warning:</strong> {s.warning}</p>}
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="mt-12" aria-labelledby="verify-heading">
          <h2 id="verify-heading" class="text-2xl font-bold text-slate-900">How to test that it's working</h2>
          <ul class="mt-4 space-y-4">
            {
              guide.verification.map((v) => (
                <li class="rounded-lg border border-emerald-200 bg-emerald-50/50 p-4">
                  <h3 class="font-semibold text-slate-900">{v.title}</h3>
                  <p class="mt-1 text-slate-700">{v.body}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="mt-12" aria-labelledby="trouble-heading">
          <h2 id="trouble-heading" class="text-2xl font-bold text-slate-900">Troubleshooting</h2>
          <dl class="mt-4 space-y-4">
            {
              guide.troubleshooting.map((t) => (
                <div class="rounded-lg border border-slate-200 p-4">
                  <dt class="font-semibold text-slate-900">{t.problem}</dt>
                  <dd class="mt-1 text-slate-700">{t.fix}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="mt-12" aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="text-2xl font-bold text-slate-900">Frequently asked questions</h2>
          <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200">
            {
              guide.faqs.map((f) => (
                <details class="faq p-4">
                  <summary class="flex items-center justify-between gap-3 font-medium text-slate-900">
                    {f.question}
                    <ChevronRight size={18} class="faq-chevron shrink-0 transition-transform" aria-hidden="true" />
                  </summary>
                  <p class="mt-2 leading-relaxed text-slate-700">{f.answer}</p>
                </details>
              ))
            }
          </div>
        </section>

        <section class="mt-12 rounded-xl border border-slate-200 bg-slate-50 p-5" aria-labelledby="notify-heading">
          <h2 id="notify-heading" class="text-lg font-bold text-slate-900">Get notified when this guide changes</h2>
          <p class="mt-1 text-sm text-slate-600">Tools change their menus often. Leave your email and we will tell you when we update this guide.</p>
          <div class="mt-4 max-w-md">
            <LeadForm
              formType="Guide update alert"
              button="Notify me"
              successMessage="Thanks! We will email you when this guide changes."
              fields={[
                { name: 'guide', label: 'Guide', type: 'hidden', value: guide.slug },
                { name: 'email', label: 'Your email', type: 'email', required: true },
              ]}
            />
          </div>
          <p class="mt-4 text-sm text-slate-600">
            Need a different guide? <a href="/request-a-guide/" class="font-medium text-indigo-700 underline">Request one we don't have yet</a>.
          </p>
        </section>

        {
          related.length > 0 && (
            <section class="mt-12" aria-labelledby="related-heading">
              <h2 id="related-heading" class="text-2xl font-bold text-slate-900">Related guides</h2>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {related.map((g) => <GuideCard guide={g} />)}
              </div>
            </section>
          )
        }
      </div>

      <aside class="mt-10 space-y-5 lg:mt-0 lg:sticky lg:top-20 lg:self-start" aria-label="Done-for-you options">
        <ExpressCard toolName={tool.name} platformName={platform.name} />
        <PartnerCard partner={partner} platformName={platform.name} />
      </aside>
    </article>
  </main>
  <MobileBar />
</Base>

<script>
  // Remember prerequisite ticks in this browser (localStorage). Fails quietly if storage is blocked.
  const article = document.querySelector<HTMLElement>('article[data-guide]');
  if (article) {
    const key = `installs-prereq-${article.dataset.guide}`;
    const boxes = article.querySelectorAll<HTMLInputElement>('input[data-prereq]');
    let saved: Record<string, boolean> = {};
    try {
      saved = JSON.parse(localStorage.getItem(key) ?? '{}');
    } catch {}
    boxes.forEach((box) => {
      box.checked = Boolean(saved[box.dataset.prereq ?? '']);
      box.addEventListener('change', () => {
        saved[box.dataset.prereq ?? ''] = box.checked;
        try {
          localStorage.setItem(key, JSON.stringify(saved));
        } catch {}
      });
    });
  }
</script>
